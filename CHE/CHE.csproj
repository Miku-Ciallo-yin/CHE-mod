<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>CHE</AssemblyName>
    <RootNamespace>CHE</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>米裤恰油</Authors>
    <Description>参考 TONE 模组，为 Among Us 增加更多职业和中立阵营</Description>

    <!--
      游戏安装目录（已装 BepInEx 的 Among Us）。
      直接引用该目录下 BepInEx\interop 中已生成的互操作程序集，
      保证编译环境与运行环境完全一致（游戏版本 2026.6.5）。
    -->
    <AmongUsDir>D:\st\steamapps\common\Among Us\CNE</AmongUsDir>
    <BepInExVersion>6.0.0-be.735</BepInExVersion>
    <HarmonyVersion>2.10.2</HarmonyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx IL2CPP 运行时（与游戏目录 BepInEx/core 版本一致） -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="$(BepInExVersion)" PrivateAssets="all" />
    <!-- Harmony 补丁库（与游戏目录 0Harmony.dll 版本一致） -->
    <PackageReference Include="HarmonyX" Version="$(HarmonyVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Il2CppInterop 运行时（互操作程序集的基类库） -->
    <Reference Include="$(AmongUsDir)\BepInEx\core\Il2CppInterop.Runtime.dll">
      <Private>false</Private>
    </Reference>
    <!-- 游戏互操作程序集（由 BepInEx 首次启动时生成） -->
    <Reference Include="$(AmongUsDir)\BepInEx\interop\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 编译后自动复制 DLL 到游戏插件目录 -->
  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="Exists('$(AmongUsDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUsDir)\BepInEx\plugins" />
    <Message Text="已部署 $(AssemblyName).dll -> $(AmongUsDir)\BepInEx\plugins" Importance="high" />
  </Target>

</Project>
